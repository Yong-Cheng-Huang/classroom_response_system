# 僅綁定本機；開發與建置版使用同一來源。
APP_PORT=3000
APP_DATA_DIR=./data
# 不提供預設密碼。未設定時老師登入停用；設定後重新啟動即可登入。
TEACHER_PASSWORD=
# OAuth client JSON 僅由後端讀取；預設為 APP_DATA_DIR/google-oauth-client.json。
GOOGLE_OAUTH_CLIENT_FILE=./data/google-oauth-client.json
# 真實 Sheets 測試只允許明確提供的可寫副本，不填原始範本 ID。
SHEETS_TEST_SPREADSHEET_ID=
