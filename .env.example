# 僅綁定本機；開發與建置版使用同一來源。
APP_PORT=3000
APP_DATA_DIR=./data
# 不提供預設密碼。未設定時老師登入停用；設定後重新啟動即可登入。
TEACHER_PASSWORD=
# 服務帳戶JSON只由後端讀取；空值預設APP_DATA_DIR/google-service-account.json。
GOOGLE_SERVICE_ACCOUNT_FILE=
# 真實 Sheets 測試只允許明確提供的可寫副本，不填原始範本 ID。
SHEETS_TEST_SPREADSHEET_ID=

# 後端公開讀取使用；可選，不可填 OAuth client secret。請勿提交實際金鑰。
GOOGLE_SHEETS_API_KEY=
